# Generated Anchor IDL is emitted LF by the WSL build; the untracked
# target/idl reference is LF. Pin the checked-in copies to raw LF so
# core.autocrlf=true on Windows can't re-trip the handoff byte-identity gate.
app/src/idl/*.json -text
mobile/src/idl/*.json -text

# Everything under deploy/ is executed or parsed by Linux (bash, systemd, nginx).
# These blobs are LF today and were verified byte-clean when committed; this is a
# guard, not a repair. core.autocrlf=true is set globally on the Windows checkout,
# and a single CR in a shebang makes a script unrunnable, so pin the tree to LF
# rather than rely on the default staying favourable.
deploy/**/*.sh      text eol=lf
deploy/**/*.conf    text eol=lf
deploy/**/*.service text eol=lf
deploy/**/*.timer   text eol=lf
# The whitepaper slicer (app/vite.config.ts) matches the LF sequence newline---newline.
# core.autocrlf=true double-converted this file on a fresh Windows checkout
# (CR CR LF) and the build failed. Keep the checkout bytes as committed.
Opta_Whitepaper_v1.md text eol=lf
