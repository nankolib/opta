    "@react-native-async-storage/async-storage": "^2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@wallet-ui/react-native-web3js": "^4.2.0",
    "bn.js": "^5.2.3",
    "buffer": "^6.0.3",
    "expo": "^54.0.0",
