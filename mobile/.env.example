# Required at build time. The release build (npm run build:release) refuses to
# run when any of these is unset: an unset RPC var silently bakes the public
# devnet endpoint into the bundle.
EXPO_PUBLIC_RPC_URL=https://rpc.opta.fyi/devnet
EXPO_PUBLIC_INDEXER_BASE=https://opta.fyi/api/chain
EXPO_PUBLIC_INDEXER_ENABLED=1
EXPO_PUBLIC_HERMES_BASE=https://hermes.pyth.network
